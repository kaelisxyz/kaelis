# Paste these into Railway > your service > Variables (or a local .env).
# Everything is optional: without keys the scanner still runs on free public data.

# Private Solana RPC (free tier at helius.dev). Faster, fewer failures, full holder lists.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# AI explanation of each scan (console.anthropic.com). Read-only, numbers are checked.
ANTHROPIC_API_KEY=
# Optional: a cheaper model, e.g. claude-haiku-5-5
KAELIS_MODEL=claude-opus-5-5

# $KAEL mint address, after launch. Turns on the live holder tower.
KAEL_MINT=

# Scans per minute per visitor (default 20)
SCAN_RATE_PER_MIN=20
